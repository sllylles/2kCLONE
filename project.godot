; Engine configuration file.
; Courtside — Godot 4.7, Mobile renderer, landscape only.

config_version=5

[application]

config/name="Courtside"
config/description="Broadcast-style basketball simulation"
config/version="0.4.2"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/low_processor_mode=false
config/quit_on_go_back=false

[autoload]

Settings="*res://autoload/settings.gd"
DataDB="*res://autoload/data_db.gd"
SaveSystem="*res://autoload/save_system.gd"
InputRouter="*res://autoload/input_router.gd"
SceneManager="*res://autoload/scene_manager.gd"
DebugOverlay="*res://autoload/debug_overlay.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
reflections/reflection_atlas/reflection_size.mobile=256
anti_aliasing/quality/msaa_3d=1
